# =============================================================================
# AI-Adaptive Honeypot Platform — Environment Variables
# Copy this file to .env and fill in production values
# NEVER commit .env to version control
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=honeypot
POSTGRES_USER=honeypot
# IMPORTANT: Change this before deploying to production!
POSTGRES_PASSWORD=changeme_in_production

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM Configuration (Groq Cloud API) ---
# Sign up free at https://console.groq.com (no credit card required)
# Supported providers: Groq, OpenAI, any OpenAI-compatible endpoint
LLM_URL=https://api.groq.com
LLM_API_KEY=gsk_your_api_key_here
MODEL_NAME=llama-3.1-8b-instant
# Groq is fast — 15s timeout is plenty (increase for slower providers)
LLM_TIMEOUT=15
